{
    "workbench.startupEditor": "none",
    "chat.disableAIFeatures": true,
    "workbench.statusBar.visible": false,
    "workbench.layoutControl.enabled": false,
    "workbench.navigationControl.enabled": false,
    "workbench.browser.showInTitleBar": false,
    "window.commandCenter": false,
    "editor.fontFamily": "Maple Mono Medium",
    "workbench.activityBar.location": "hidden",

    "workbench.colorCustomizations": {
        "editor.background": "#1d1d20",
        "activityBar.background": "#1d1d20",
        "sideBar.background": "#1d1d20",
        "sideBarSectionHeader.background": "#1d1d20",
        "tab.inactiveBackground": "#1d1d20",
        "editorGroupHeader.tabsBackground": "#1d1d20",
        "statusBar.background": "#1d1d20",
        "titleBar.activeBackground": "#1d1d20",
        "editor.selectionBackground": "#424242",
        "editorGutter.background": "#1d1d20",
        "breadcrumb.background": "#1d1d20",
        "editorStickyScroll.background": "#1d1d20",
        "menu.selectionBorder": "#ffffff"
    },
    "editor.stickyScroll.enabled": false,
    "workbench.editor.empty.hint": "hidden",
    "terminal.integrated.initialHint": false,
}