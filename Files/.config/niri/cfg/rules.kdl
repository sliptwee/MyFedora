layer-rule {
  match namespace="^noctalia-backdrop"
  place-within-backdrop true
}

layer-rule {
  match namespace="^noctalia-panel"
  opacity 0.7
}

window-rule {
    draw-border-with-background false
    opacity 0.7
    background-effect {
        blur true
    }
}

window-rule {
    match is-focused=true
    background-effect {
        blur true
    }
}

// --- Default Niri Steam stuff ---

    window-rule {
        match app-id="steam"
        exclude title=r"^[Ss]team$"
        open-floating true
}

    window-rule {
       match app-id="steam" title=r"^notificationtoasts_\d+_desktop$"
       default-floating-position x=10 y=10 relative-to="bottom-right"
       open-focused false
}

// --------------------------------

window-rule { match app-id=r"vlc"; opacity 1.0; }
window-rule { match app-id=r"helium"; opacity 1.0; }
window-rule { match app-id=r"org.vinegarhq.Sober"; opacity 1.0; }
window-rule { match app-id=r"io.github.diegopvlk.Cine"; opacity 1.0; }
window-rule { match app-id=r"zen"; opacity 1.0; }
window-rule { match app-id=r"com.infinipaint.infinipaint"; opacity 1.0; }
window-rule { match app-id=r"org.gnome.Boxes"; opacity 1.0; }
window-rule { match app-id=r"org.gnome.ColorProfileViewer"; opacity 1.0; }
window-rule { match app-id=r"org.gnome.Connections"; opacity 1.0; }
window-rule { match app-id=r"org.gnome.Loupe"; opacity 1.0; }
window-rule { match app-id=r"org.gnome.SimpleScan"; opacity 1.0; }
window-rule { match app-id=r"org.gnome.Epiphany"; opacity 1.0; }
window-rule { match app-id=r"org.gnome.Showtime"; opacity 1.0; }
window-rule { match app-id=r"libreoffice-*"; opacity 1.0; }
window-rule { match app-id=r"com.obsproject.Studio"; opacity 1.0; }
window-rule { match app-id=r"anydesk"; opacity 1.0; }
window-rule { match app-id=r"io.github.diegopvlk.Cine"; opacity 1.0; }
window-rule { match app-id=r"org.kde.kdenlive"; opacity 1.0; }
