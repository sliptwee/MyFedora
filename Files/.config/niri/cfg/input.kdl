input {
    focus-follows-mouse max-scroll-amount="33%"
    workspace-auto-back-and-forth
    keyboard {
        xkb {
            layout "us, ru"
            options "grp:alt_shift_toggle"
        }
        numlock
        repeat-delay 300
        repeat-rate 30
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        accel-profile "flat"
        accel-speed 0.0
    }
}

gestures {
    hot-corners 
}
